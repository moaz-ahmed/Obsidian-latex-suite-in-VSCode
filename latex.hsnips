context math(context)
snippet `tayl` "Taylor expansion" A
${1:f}(${2:x} + ${3:h}) = ${1:f}(${2:x}) + ${1:f}'(${2:x})${3:h} + ${1:f}''(${2:x}) \\frac{${3:h}^{2}}{2!} + \\dots$0
endsnippet

context math(context)
snippet `iden(\d)` "N x N identity matrix" A
``
const n = parseInt(m[1]);
let arr = [];
for (let j = 0; j < n; j++) {
    arr[j] = [];
    for (let i = 0; i < n; i++) {
        arr[j][i] = (i === j) ? 1 : 0;
    }
}
let rows = arr.map(row => row.join(" & ")).join(" \\\\\\\\\n");
rv = "\\begin{pmatrix}\n" + rows + "\n\\end{pmatrix}";
``
endsnippet
