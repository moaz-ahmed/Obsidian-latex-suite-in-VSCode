global
function math(context) {
    return context.scopes.some(s => s.startsWith("meta.math"));
}
endglobal

// =====================
// Math mode
// =====================

snippet `mk` "Inline Math" A
\$$1\$$0
endsnippet

snippet `dm` "Display Math" bA
$$
$1
$$
$0
endsnippet

